# Copier en deploy/.env (jamais commité) et adapter.
HUB_TAG=dev
# nom MagicDNS du nœud Tailscale « hub » (visible dans la console Tailscale après le 1er démarrage)
HUB_PUBLIC_ORIGIN=https://hub.votre-tailnet.ts.net
# dossier du Mac où les bots et le Finder déposent les exports
HUB_INBOX=/Users/nathan/PersonalHub/inbox
# disque externe monté pour la réplique Litestream et le dépôt restic local
HUB_REPLICA=/Volumes/HubBackup/litestream
HUB_RESTIC_LOCAL=/Volumes/HubBackup/restic
# clé privée age de la machine (0400), passée en secret Docker
HUB_AGE_KEY=/Users/nathan/.config/hub/age.key
# secrets chiffrés age (mot de passe restic, plus tard identifiants des bots)
HUB_SECRETS=/Users/nathan/.config/hub/secrets.enc.yaml
# clé d'authentification Tailscale à usage unique (premier démarrage seulement, puis la vider)
TS_AUTHKEY=
