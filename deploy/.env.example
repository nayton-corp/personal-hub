# Réglages de l'instance, écrits par `make init` (docs/exploitation/installation.md) ; sinon copier en
# deploy/.env et adapter. Jamais commité.
HUB_TAG=dev
# registre des images publiées : make deploy TAG=vX.Y.Z les tire au lieu de les construire
# (docker login ghcr.io une fois, docs/exploitation/versions.md) ; HUB_BUILD=1 force la construction locale
#HUB_REGISTRY=ghcr.io/nayton-corp/personal-hub
# nom MagicDNS du nœud Tailscale « hub » (visible dans la console Tailscale après le 1er démarrage)
HUB_PUBLIC_ORIGIN=https://hub.votre-tailnet.ts.net
# fuseau de l'instance : jour civil des chiffres, horaires des collecteurs et des tâches
HUB_TZ=Europe/Zurich
# devise de base (ISO 4217) : patrimoine, budgets et chiffres clés ; fixée à la création de
# finance.db, le hub refuse de démarrer si elle change ensuite
HUB_CURRENCY=CHF
# pays (ISO, deux lettres) tant que le profil n'est pas enregistré dans l'app : il choisit le pack
# de règles d'une base neuve et les modules du pays (pilier 3a en Suisse)
HUB_COUNTRY=CH
# domaines montés : * pour tous ceux de l'image, ou une liste (finance,agenda) ; un domaine
# éteint n'a ni base, ni onglet, ni connecteur. Sa base reste sur le disque si elle existe.
HUB_DOMAINS=*
# dossier où les bots et le Finder déposent les exports
HUB_INBOX=/chemin/PersonalHub/inbox
# réplique Litestream et dépôt restic local (de préférence sur un autre disque)
HUB_REPLICA=/chemin/PersonalHub/backup/litestream
HUB_RESTIC_LOCAL=/chemin/PersonalHub/backup/restic
# clé privée age de la machine (0400), passée en secret Docker
HUB_AGE_KEY=/chemin/.config/hub/age.key
# secrets chiffrés age (mot de passe restic, sujet ntfy)
HUB_SECRETS=/chemin/.config/hub/secrets.enc.yaml
# jetons des deux services collecteurs, écrits par make deploy (docs/collectors.md)
HUB_COLLECTOR_SECRETS=/chemin/.config/hub/collectors
# cartes qu'un jeton (le brain) peut proposer par heure ; plus haut le temps d'un rattrapage
#HUB_PROPOSALS_PER_HOUR=60
# les collecteurs suivent les connexions ajoutées dans l'app (l'IA locale tourne hors conteneurs :
# docs/brain.md)
COMPOSE_PROFILES=collectors
# clé d'authentification Tailscale à usage unique (premier démarrage seulement, puis la vider)
TS_AUTHKEY=
