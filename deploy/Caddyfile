# Caddy dans le conteneur « web ». Le TLS est terminé par `tailscale serve` (conteneur
# « tailscale »), qui relaie vers web:8080 ; rien n'est publié sur le Mac.
{
	admin off
	auto_https off
	persist_config off
	servers {
		trusted_proxies static private_ranges 100.64.0.0/10
	}
}

:8080 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:8710
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		# revalidés à chaque chargement (ETag) : après un déploiement, Safari ne mélange
		# jamais un module neuf et un ancien (l'app restait sur « Chargement… »)
		header Cache-Control "no-cache"
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}
